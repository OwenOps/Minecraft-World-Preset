{
  "schemaVersion": 1,
  "id": "worldpresetpack",
  "version": "${version}",
  "name": "World Preset Pack",
  "description": "A collection of custom world presets for Minecraft",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/worldpresetpack/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.worldpresetpack.WorldPresetPackMod"
    ],
    "client": [
      "com.worldpresetpack.client.WorldPresetPackClient"
    ],
    "fabric-datagen": [
      "com.worldpresetpack.datagen.WorldPresetPackDatagen"
    ]
  },
  "mixins": [
    "worldpresetpack.mixins.json",
    {
      "config": "worldpresetpack.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=1.21.4",
    "java": ">=21"
  }
}
