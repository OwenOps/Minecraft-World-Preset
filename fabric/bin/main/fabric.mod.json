{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [],
  "contact": {},
  "license": "${license}",
  "icon": "assets/worldpresetpack/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.worldpresetpack.WorldPresetPackMod"
    ],
    "client": [
      "com.worldpresetpack.client.WorldPresetPackClient"
    ],
    "fabric-datagen": [
      "com.worldpresetpack.datagen.WorldPresetPackDatagen"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    {
      "config": "${mod_id}.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  }
}
